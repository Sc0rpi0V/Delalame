# Modèle de configuration — aucun identifiant ni secret ici.
# `make install` le copie en .env. Les valeurs réelles vont dans des fichiers jamais versionnés :
#   .env.local          généré par ddev (DATABASE_URL, MAILER_DSN)
#   .env.dev.local      généré par `make install` (APP_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD)
#   .env.test.local     généré par `make db-test`
# En production : variables d'environnement du serveur ou .env.local.

APP_ENV=dev
APP_SECRET=
APP_DEBUG=1

DATABASE_URL=
MAILER_DSN=null://null

# Compte admin créé par les fixtures (dev uniquement)
ADMIN_EMAIL=
ADMIN_PASSWORD=

###> symfony/routing ###
DEFAULT_URI=https://artisan.ddev.site:8443
###< symfony/routing ###

###> symfony/messenger ###
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
