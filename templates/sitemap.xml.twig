<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in staticPages %}
    <url>
        <loc>{{ url(item.route) }}</loc>
        {% if item.route == 'app_gallery' and galleryLastUpdate %}
        <lastmod>{{ galleryLastUpdate|date('Y-m-d') }}</lastmod>
        {% endif %}
        <changefreq>{{ item.changefreq }}</changefreq>
        <priority>{{ item.priority }}</priority>
    </url>
{% endfor %}
{% for item in legalPages %}
    <url>
        <loc>{{ url(item.route) }}</loc>
        {% if item.lastmod %}
        <lastmod>{{ item.lastmod|date('Y-m-d') }}</lastmod>
        {% endif %}
        <changefreq>{{ item.changefreq }}</changefreq>
        <priority>{{ item.priority }}</priority>
    </url>
{% endfor %}
</urlset>
