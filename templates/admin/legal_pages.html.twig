{% extends '@EasyAdmin/layout.html.twig' %}

{% block page_title %}Pages légales{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin-quill') }}
{% endblock %}

{% block main %}

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card">
    <div class="card-header p-0 border-bottom-0">
        <ul class="nav nav-tabs px-3 pt-2" id="legalTabs" role="tablist">
            {% for type, page in pages %}
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link {% if type == active_tab %}active{% endif %}"
                    id="tab-{{ type }}"
                    data-bs-toggle="tab"
                    data-bs-target="#panel-{{ type }}"
                    type="button"
                    role="tab"
                    aria-controls="panel-{{ type }}"
                    aria-selected="{{ type == active_tab ? 'true' : 'false' }}"
                >
                    {{ constant('App\\Entity\\LegalPage::TYPES')[type] }}
                </button>
            </li>
            {% endfor %}
        </ul>
    </div>

    <div class="tab-content p-4" id="legalTabsContent">
        {% for type, form in forms %}
        <div
            class="tab-pane fade {% if type == active_tab %}show active{% endif %}"
            id="panel-{{ type }}"
            role="tabpanel"
            aria-labelledby="tab-{{ type }}"
        >
            <p class="text-muted small mb-3">
                Dernière mise à jour :
                {{ pages[type].updatedAt is defined ? pages[type].updatedAt|date('d/m/Y à H:i') : '—' }}
                &nbsp;·&nbsp;
                <a href="{{ path('app_' ~ type) }}" target="_blank" class="link-secondary">
                    Voir sur le site <i class="fa fa-external-link-alt fa-xs"></i>
                </a>
            </p>

            {{ form_start(form, {action: path('admin_legal_pages', {tab: type}), method: 'POST'}) }}
                {{ form_widget(form.content) }}
                <div class="mt-3">
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}
        </div>
        {% endfor %}
    </div>
</div>

{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin-quill') }}
{% endblock %}
