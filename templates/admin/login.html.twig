<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administration — {{ site_name }}</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #EDEAE4; font-family: 'DM Sans', system-ui, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { background: #fff; border-radius: 2px; box-shadow: 0 4px 16px rgba(45,41,38,.12); padding: 2.5rem; width: 100%; max-width: 400px; }
        .logo { display: flex; align-items: center; gap: .75rem; margin-bottom: 2rem; }
        .logo-icon { width: 44px; height: 44px; background: #7C5C3E; border-radius: 2px; display: flex; align-items: center; justify-content: center; }
        .logo-icon svg { width: 24px; height: 24px; color: #F8F5F0; }
        .logo-text h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.1rem; color: #2D2926; }
        .logo-text p { font-size: .75rem; color: #6B6460; }
        h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; color: #2D2926; margin-bottom: 1.5rem; }
        label { display: block; font-size: .875rem; font-weight: 500; color: #2D2926; margin-bottom: .25rem; }
        input[type="email"], input[type="password"] {
            width: 100%; padding: .625rem 1rem; border: 1px solid #EDEAE4; border-radius: 2px;
            font-size: .9375rem; color: #2D2926; background: #fff; margin-bottom: 1rem; outline: none; transition: border-color .2s;
        }
        input:focus { border-color: #7C5C3E; box-shadow: 0 0 0 2px rgba(124,92,62,.15); }
        button { width: 100%; padding: .75rem; background: #7C5C3E; color: #F8F5F0; border: none; border-radius: 2px; font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background .2s; margin-top: .5rem; }
        button:hover { background: #4E3728; }
        .error { background: #FEF2F2; border: 1px solid #B94A48; color: #B94A48; padding: .75rem 1rem; border-radius: 2px; font-size: .875rem; margin-bottom: 1rem; }
        .back { text-align: center; margin-top: 1.5rem; font-size: .8125rem; color: #6B6460; }
        .back a { color: #7C5C3E; text-decoration: underline; }
    </style>
</head>
<body>
<div class="card">
    <div class="logo">
        <div class="logo-icon">
            <svg fill="currentColor" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </div>
        <div class="logo-text">
            <h1>{{ site_name }}</h1>
            <p>Espace administration</p>
        </div>
    </div>

    <h2>Connexion</h2>

    {% if error %}
    <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}">
        <label for="email">Adresse email</label>
        <input type="email" id="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Se connecter</button>
    </form>

    <div class="back"><a href="{{ path('app_home') }}">← Retour au site</a></div>
</div>
</body>
</html>
