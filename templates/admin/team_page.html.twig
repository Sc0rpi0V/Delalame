{% extends '@EasyAdmin/layout.html.twig' %}

{% block page_title %}Présentation de l'équipe{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor { min-height: 280px; font-size: 14px; }
        .ql-toolbar.ql-snow { border-radius: 4px 4px 0 0; }
        .ql-container.ql-snow { border-radius: 0 0 4px 4px; }
    </style>
{% endblock %}

{% block main %}

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Section "Qui sommes-nous ?"</h5>
        <p class="text-muted small mb-0 mt-1">
            Ce texte apparaît en haut de la page <a href="/notre-equipe" target="_blank" class="link-secondary">Notre équipe <i class="fa fa-external-link-alt fa-xs"></i></a>.
            {% if block.updatedAt is defined %}
                Dernière modification : {{ block.updatedAt|date('d/m/Y à H:i') }}
            {% endif %}
        </p>
    </div>
    <div class="card-body">
        {{ form_start(form, {action: path('admin_team_page'), method: 'POST'}) }}
            {{ form_widget(form.content) }}
            <div class="mt-3">
                {{ form_widget(form.save) }}
            </div>
        {{ form_end(form) }}
    </div>
</div>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
(function () {
    var textarea = document.querySelector('.team-intro-editor');
    if (!textarea) { return; }

    var editorDiv = document.createElement('div');
    textarea.parentNode.insertBefore(editorDiv, textarea);
    textarea.style.display = 'none';

    var quill = new Quill(editorDiv, {
        theme: 'snow',
        modules: {
            toolbar: [
                [{ header: [2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ color: [] }],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['link', 'clean']
            ]
        },
        placeholder: 'Rédigez la présentation de l\'équipe…'
    });

    if (textarea.value.trim()) {
        quill.root.innerHTML = textarea.value;
    }

    textarea.form.addEventListener('submit', function () {
        textarea.value = quill.root.innerHTML;
    });
})();
</script>

{% endblock %}
